{
	email jean-luc@leminsky.net
}

(headers) {
	header {
		# Abschnitt 8 SPEC: Indexierung auch fuer Dateien ohne HTML-Kopf verbieten
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Der Build erzeugt ausschliesslich externe, gleichnamige Assets -
		# keine Inline-Skripte und keine Inline-Styles. Siehe deploy/README.md.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		# Grundregel: vor jeder Nutzung revalidieren. Gilt fuer die HTML-Seiten,
		# die sich bei jedem Deploy aendern koennen. Wird unten fuer Assets
		# ueberschrieben - `route` laeuft in der Standardreihenfolge nach `header`.
		Cache-Control "no-cache"
		-Server
	}
}

(caching) {
	route {
		# Vom Bundler gehashte Dateien liegen flach in dist/ (chunk-a1b2c3d4.js,
		# favicon-948y2f3f.svg). Der Hash wechselt mit dem Inhalt, also darf der
		# Browser sie fuer immer behalten. [^/] grenzt sie von /media/ ab -
		# Caddys Regex-Engine (RE2) kann kein negatives Lookahead.
		@hashed path_regexp ^/[^/]+-[a-z0-9]{8}\.(js|css|svg|woff2|jpe?g|png|webp|avif)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Fotos und Videos aus public/media behalten ihren Namen, koennen also
		# unter gleichem Pfad ausgetauscht werden. Ein Tag Cache ist der
		# Kompromiss zwischen Upstream-Last und Aktualitaet.
		@media path /media/*
		header @media Cache-Control "public, max-age=86400"

		# Die Schrift traegt ihre Version im Dateinamen (Geist-Variable-v1.7.2),
		# ein Wechsel aendert also den Pfad. Damit ist immutable sicher.
		@fonts path /fonts/*
		header @fonts Cache-Control "public, max-age=31536000, immutable"
	}
}

www.leminsky.net {
	redir https://leminsky.net{uri} permanent
}

leminsky.net {
	root * /srv/www
	import headers
	import caching
	encode zstd gzip

	# Source Maps nie ausliefern, falls sie doch im dist/ landen
	@maps path *.js.map *.css.map
	respond @maps 404

	# URLs ohne Endung auf die passende .html aufloesen
	try_files {path} {path}.html {path}/index.html
	file_server

	# file_server behaelt den Fehlerstatus, wenn es in handle_errors laeuft
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		# DSGVO-Datensparsamkeit: IPs gekuerzt protokollieren (Art. 5 Abs. 1 lit. c)
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
		}
	}
}
