# Kopie als deploy/.env anlegen. Die .env gehoert NICHT ins Repo (siehe .gitignore).

# IONOS API-Key aus dem Developer Portal: Public Prefix und Secret mit einem
# Punkt verbunden -> <prefix>.<secret>
# Wird gebraucht fuer dyndns-create.sh und - falls verwendet - fuer die
# DNS-01-Challenge in Caddy.
IONOS_API_TOKEN=

# Wird von dyndns-create.sh erzeugt und hier eingetragen.
# Form: https://ipv4.api.hosting.ionos.com/dns/v1/dyndns?q=...
IONOS_DYNDNS_URL=
